# ===================================================================
# Plantilla de Configuración de Firma Release para OYL Frutos Secos
# Copiar este archivo como keystore.properties en la raíz del proyecto
# ¡NUNCA SUBIR keystore.properties NI ARCHIVOS .jks A GIT/GITHUB!
# ===================================================================

# Ruta al archivo de almacén de claves (relativo al módulo app o absoluto)
storeFile=../oyl-release-key.jks

# Contraseña del almacén de claves (keystore)
storePassword=tu_password_seguro_aqui

# Alias asignado a la clave durante su generación
keyAlias=oyl_key_alias

# Contraseña de la clave privada
keyPassword=tu_password_seguro_aqui
