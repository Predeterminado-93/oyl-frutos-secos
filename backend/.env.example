# ===================================================================
# Variables de Entorno - OYL Frutos Secos Microservicios
# Copiar este archivo como .env o configurar estas variables en el entorno
# ===================================================================

# Configuración de Eureka Server
EUREKA_URI=http://localhost:8761/eureka/

# Configuración Centralizada de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Conexiones JDBC por Microservicio (PostgreSQL Bounded Contexts)
DB_URL_USUARIOS=jdbc:postgresql://localhost:5432/oyl_usuarios
DB_URL_PRODUCTOS=jdbc:postgresql://localhost:5432/oyl_productos
DB_URL_VENTAS=jdbc:postgresql://localhost:5432/oyl_ventas

# Puertos Estándar de los Servicios
PORT_EUREKA=8761
PORT_GATEWAY=8080
PORT_MS_USUARIOS=8081
PORT_MS_PRODUCTOS=8082
PORT_MS_VENTAS=8083
